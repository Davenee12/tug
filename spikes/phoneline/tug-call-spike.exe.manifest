<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Embedded into tug-call-spike.exe by build.rs. The <msix> element is what ties this unpackaged
  exe to the sparse package registered with Add-AppxPackage -ExternalLocation: publisher,
  packageName and applicationId must match package/AppxManifest.xml exactly, or the process
  starts without package identity.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="JordanLee.TugCallSpike" version="1.0.0.0" processorArchitecture="amd64"/>
  <msix xmlns="urn:schemas-microsoft-com:msix.v1"
        publisher="CN=Jordan Lee Dev"
        packageName="JordanLee.TugCallSpike"
        applicationId="spike"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
