{
  "manifest_version": 3,
  "name": "tug",
  "short_name": "tug",
  "version": "0.1.0",
  "description": "Your iPhone's verification codes, texts and music in the browser, from the tug app on your Windows PC.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["nativeMessaging", "contextMenus", "activeTab", "scripting"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "tug",
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "Open tug"
    },
    "fill-code": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Fill the newest verification code from your iPhone"
    }
  }
}
